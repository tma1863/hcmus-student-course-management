POSTGRES_DB=student_course_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

APP_PORT=8080

# Used by the app only when run locally on the host (./mvnw quarkus:dev).
# In Docker these are overridden by docker-compose to target the postgres service.
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_JDBC_URL=jdbc:postgresql://localhost:5432/student_course_management
